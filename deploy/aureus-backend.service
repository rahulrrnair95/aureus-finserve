[Unit]
Description=Aureus Finserve backend (Spring Boot)
After=network-online.target mssql-server.service
Wants=network-online.target
Requires=mssql-server.service

[Service]
User=aureus
Group=aureus
# config/secrets.yml is read relative to this folder
WorkingDirectory=/opt/aureus/backend
ExecStart=/usr/bin/java -Xms256m -Xmx1024m -Duser.timezone=Asia/Kolkata -jar /opt/aureus/backend/aureus-backend.jar
SuccessExitStatus=143
Restart=always
RestartSec=10
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
